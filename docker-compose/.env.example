# 9Router — Docker Compose environment
#
#   cp .env.example .env
#   # then fill in the two secrets below
#
# NEVER commit .env — it holds the admin password and the JWT signing key.

# ---------------------------------------------------------------------------
# Required — generate real values, do not ship the placeholders
# ---------------------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=
# Password for the initial admin login. Change it in the UI after first login.
INITIAL_PASSWORD=

# ---------------------------------------------------------------------------
# Compose-level knobs (consumed by docker-compose.yml, not by the app)
# ---------------------------------------------------------------------------
# Pin these to a version in production instead of :latest.
# 9Router tags are bare SemVer with no leading "v" — e.g. NINEROUTER_TAG=0.5.55
# List them: https://hub.docker.com/r/decolua/9router/tags
NINEROUTER_TAG=latest
HEADROOM_TAG=latest

# Host directory for the SQLite DB and runtime state, mounted at /app/data.
# Relative paths resolve against the docker-compose.yml directory.
# Use an absolute path in production, e.g. /var/lib/9router or /srv/9router/data.
# The container's entrypoint chowns this directory to uid/gid 1000 on startup,
# so on Linux it will change owner on the host. Create it beforehand if you
# want it owned by a specific user.
DATA_PATH=./data

# Where the published ports are bound on the host.
# 127.0.0.1 = local only (default). Use 0.0.0.0 only behind a reverse proxy
# that terminates TLS, and set AUTH_COOKIE_SECURE=true when you do.
BIND_ADDR=127.0.0.1
HOST_PORT=20128
HEADROOM_BIND_ADDR=127.0.0.1
HEADROOM_HOST_PORT=8787

# ---------------------------------------------------------------------------
# Security and ops
# ---------------------------------------------------------------------------
# openssl rand -hex 32
API_KEY_SECRET=
# openssl rand -hex 16
MACHINE_ID_SALT=
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
# Set to true once 9Router is served over HTTPS.
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# ---------------------------------------------------------------------------
# Cloud sync
# ---------------------------------------------------------------------------
# BASE_URL is called by the container's own internal sync job, so it must be
# the *container-internal* address — not the host port you published above.
BASE_URL=http://127.0.0.1:20128
CLOUD_URL=https://9router.com

# Public/browser-facing URL. Upstream documents these as backward-compatible;
# the server prefers BASE_URL/CLOUD_URL above. Next.js normally inlines
# NEXT_PUBLIC_* at image build time, so setting them here may have no effect on
# an already-built image — treat BASE_URL/CLOUD_URL as the ones that matter.
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# ---------------------------------------------------------------------------
# Optional — outbound proxy for upstream provider calls
# Lowercase variants (http_proxy, https_proxy, all_proxy, no_proxy) also work.
# Note: 127.0.0.1 here means *inside the container*. To reach a proxy on the
# Docker host use host.docker.internal — and on Linux you must also uncomment
# the extra_hosts block in docker-compose.yml, or that name will not resolve.
# ---------------------------------------------------------------------------
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# ALL_PROXY=socks5://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,headroom

# ---------------------------------------------------------------------------
# Optional — verbose application logging
# ---------------------------------------------------------------------------
# DEBUG=true

# ---------------------------------------------------------------------------
# Optional — SearXNG endpoint for the built-in unauthenticated web-search provider
# ---------------------------------------------------------------------------
# SEARXNG_URL=http://searxng:8080/search

# ---------------------------------------------------------------------------
# Pinned by docker-compose.yml — do not set here, they will be ignored:
#   DATA_DIR, PORT, HOSTNAME, NODE_ENV, HEADROOM_URL
# ---------------------------------------------------------------------------
