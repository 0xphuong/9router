# helm-secrets template.
#
# Copy to secrets.yaml, fill in real values, then encrypt it in place with SOPS.
# secrets.yaml is gitignored; only the encrypted form should ever be committed,
# and only if your .sops.yaml is set up to encrypt it.
#
#   cp secrets.yaml.example secrets.yaml
#   # generate the values:
#   openssl rand -hex 32   # jwtSecret, apiKeySecret
#   openssl rand -hex 16   # machineIdSalt
#   $EDITOR secrets.yaml
#
#   sops --encrypt --in-place secrets.yaml
#
# Install or upgrade through the helm-secrets plugin, which decrypts on the fly:
#
#   helm plugin install https://github.com/jkroepke/helm-secrets
#   helm secrets install ninerouter ./helm/ninerouter -f secrets.yaml
#   helm secrets upgrade ninerouter ./helm/ninerouter -f secrets.yaml
#
# Values here override the samples in values.yaml, so once this file is in play
# the chart stops warning about them.

auth:
  jwtSecret: ""
  initialPassword: ""
  apiKeySecret: ""
  machineIdSalt: ""
