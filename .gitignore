# Local environment — holds JWT_SECRET and INITIAL_PASSWORD
.env
*.env
!.env.example

# Bind-mounted runtime data (default DATA_PATH) — SQLite DB, certs, backups
docker-compose/data/

# Ansible — vault.yml holds JWT_SECRET and INITIAL_PASSWORD even when encrypted;
# keeping it out of the repo avoids relying on the vault password alone.
ansible/group_vars/*/vault.yml
ansible/inventory/*.local.yml
*.retry
.ansible/

# Helm — these hold JWT_SECRET and INITIAL_PASSWORD.
# secrets.yaml is the helm-secrets file: ignored so a decrypted one cannot be
# committed by accident. Commit the SOPS-encrypted form under another name.
helm/**/values-local.yaml
helm/**/values-*.local.yaml
helm/**/secrets.yaml
helm/**/charts/
*.tgz

# Local deployment config: environment-specific, not chart source. The leading
# path anchors these to helm/ itself, so helm/ninerouter/values.yaml — the
# chart's own defaults — stays tracked.
helm/values.yaml
helm/values-*.yaml
helm/helmfile.yaml
helm/helmfile.d/
helm/helm_vars/

# OS / editor
.DS_Store
*.swp
