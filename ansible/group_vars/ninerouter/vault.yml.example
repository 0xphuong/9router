---
# Copy to vault.yml, fill in real values, then encrypt it:
#
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
#
# Generate the values with:
#   openssl rand -hex 32   # jwt secret, api key secret
#   openssl rand -hex 16   # machine id salt
#
# vault.yml is gitignored. This example file is not — keep it free of real values.

vault_ninerouter_jwt_secret: ""
vault_ninerouter_initial_password: ""
vault_ninerouter_api_key_secret: ""
vault_ninerouter_machine_id_salt: ""
